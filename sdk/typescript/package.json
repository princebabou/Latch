{
  "name": "@latch-security/sdk",
  "version": "0.2.0-alpha.1",
  "description": "Fail-closed TypeScript client for the Latch Enforcement API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princebabou/Latch.git",
    "directory": "sdk/typescript"
  },
  "bugs": "https://github.com/princebabou/Latch/issues",
  "homepage": "https://github.com/princebabou/Latch#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@langchain/langgraph": "1.4.7",
    "@types/node": "22.15.3",
    "langchain": "1.5.2",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@langchain/langgraph": ">=1.4.0 <2",
    "langchain": ">=1.5.0 <2"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  }
}
